# Hébergement Apache (ex. mutualisé) : redirige les adresses comme /contact vers l'application.
# Sans effet (et supprimable) sur Netlify, Vercel, GitHub Pages...
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
