# Copiez ce fichier en ".env" (ne le publiez jamais sur GitHub) puis adaptez les valeurs.
# Toutes les variables sont facultatives : sans elles, le site utilise les valeurs par défaut du code.

# Compte EmailJS (https://www.emailjs.com)
VITE_EMAILJS_SERVICE_ID=service_nasri
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_NEWSLETTER=template_vkabwua

# Modèle EmailJS du formulaire de contact. Tant qu'il est vide, le formulaire ouvre la messagerie
# du visiteur avec le message pré-rempli (rien n'est jamais "faussement" envoyé).
VITE_EMAILJS_TEMPLATE_CONTACT=
